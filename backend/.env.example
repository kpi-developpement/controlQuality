# Port du serveur Express
PORT=5000

# Connexion MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kcq

# Secret JWT (OBLIGATOIRE — changez en production)
JWT_SECRET=changez_moi_en_production_abc123

